   <children>
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="DODGERBLUE" height="369.0" layoutX="13.0" layoutY="16.0" stroke="BLACK" strokeType="INSIDE" width="574.0" />
      <TextArea layoutX="75.0" layoutY="60.0" prefHeight="200.0" prefWidth="450.0" text="Hej och välkommen till Sänka Skepp!&#10;&#10;Valj om du vill starta ett nytt spel, &#10;eller gå med i ett spel: ">
