            <Font size="23.0" />
         </font>
      </TextArea>
      <Button fx:id="startaSpel" layoutX="104.0" layoutY="306.0" mnemonicParsing="false" onAction="#startaSpelet" prefHeight="31.0" prefWidth="150.0" text="Starta nytt spel">
         <font>
            <Font size="15.0" />
         </font>
      </Button>
      <Button fx:id="joinGameButton" layoutX="341.0" layoutY="306.0" mnemonicParsing="false" onAction="#joinGame" prefHeight="31.0" prefWidth="150.0" text="Gå med i ett spel">
